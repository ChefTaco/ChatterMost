DATABASE_URL="postgresql://chattermost_app:change-me@localhost:55432/chattermost?schema=public"
SERVER_URL="http://localhost:8065"
PORT=8065
COOKIE_SECRET="replace-with-at-least-32-random-characters"
TOKEN_HASH_SECRET="replace-with-a-separate-token-hash-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-admin-password"
ADMIN_EMAIL="admin@example.test"
ADMIN_FORCE_PASSWORD_RESET=false
SESSION_COOKIE_NAME="MMSID"
SESSION_DAYS=30
NODE_ENV="development"
HERMES_BOT_USERNAME="hermes"
HERMES_BOT_DISPLAY_NAME="Hermes Agent"
HERMES_BOT_TOKEN=""
HERMES_ALLOWED_USER_IDS=""
FILE_STORAGE_PATH="./data/files"
PROFILE_IMAGE_STORAGE_PATH="./data/profile-images"
STORE_BACKEND="json"
STORE_PATH="./data/chattermost-store.json"
ENABLE_TELEMETRY=false
ENABLE_DIAGNOSTICS=false
ENABLE_SECURITY_ALERT_CHECKS=false
ENABLE_PUBLIC_FILE_LINKS=false
ENABLE_REDIS_FANOUT=false
ENABLE_DISTRIBUTED_RATE_LIMIT=false
REDIS_URL="redis://127.0.0.1:6379"
COMPATIBILITY_SERVER_VERSION="11.8.0"
COMPATIBILITY_PROFILE="mattermost-v11.8"
BUILD_NUMBER="chattermost-0.1.0"
BUILD_HASH="local"
BUILD_DATE="1970-01-01T00:00:00.000Z"
RELEASE_ID="local"
ALLOW_VERSION_ADVERTISEMENT=false
TRUSTED_PROXIES=""
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_LOGIN_SOURCE_MAX=20
RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
# Local development/test convenience only; production startup rejects true.
ENABLE_DEV_DEFAULTS=false

# Deployment-only variables used by scripts/deploy.sh.
CHAT_SERVER_URL="https://chat.example.test:9443"
CHAT_SERVER_PORT=9443
CHAT_SERVER_INTERNAL_PORT=19065
CHAT_SERVER_TLS_PORT=9443
CHAT_SERVER_ADMIN_USERNAME="admin"
CHAT_SERVER_ADMIN_PASSWORD=""
CHAT_SERVER_ADMIN_EMAIL="admin@example.test"
CHAT_SERVER_COOKIE_SECRET=""
CHAT_SERVER_TOKEN_HASH_SECRET=""
CHAT_SERVER_POSTGRES_PASSWORD=""
CHAT_SERVER_TRUSTED_PROXIES="127.0.0.1/32,::1/128"
CHAT_SERVER_RATE_LIMIT_MAX_KEYS=10000
CHAT_SERVER_RATE_LIMIT_LOGIN_SOURCE_MAX=20
CHAT_SERVER_RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
# Pin the verified server key in ignored deploy/ssh_known_hosts.
CHAT_SERVER_DEPLOY_SSH_KEY=""
CHAT_SERVER_USE_TLS=true
CHAT_SERVER_DEPLOY_USER="chattermost"
CHAT_SERVER_DEPLOY_HOST="chat.example.test"
CHAT_SERVER_DEPLOY_PATH="/srv/chattermost"
CHAT_SERVER_DEPLOY_TAILSCALE=false
CHAT_SERVER_DEPLOY_TAILSCALE_CERT=""
# SHA-256 of the dedicated Magnus Security Fusion service credential.
# The raw credential belongs only in the collector's protected environment.
SECURITY_FUSION_SERVICE_TOKEN_HASH=

# Container distribution generates separate protected files under its installation
# directory. Do not copy this operator file into an image or distribution directory.
# See docs/containers.md for distribution setup and reverse-proxy configuration.
# Lifecycle credentials stay in the distribution's private secrets/runtime.env.
# Keep its administrator login current for authenticated readiness checks.
# Backup/restore and app rollback are explicit commands; see docs/containers.md.
