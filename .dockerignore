# Allowlist: private files cannot enter any build context layer.
**
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!scripts/container.ts
!scripts/probe-tls.ts
!scripts/image-notices.ts
!scripts/schema-policy.mjs
!prisma/schema.prisma
!prisma/migrations/**
!deploy/Dockerfile
!deploy/schema-policy.json
!LICENSE
!NOTICE

# Defense in depth if private material is accidentally placed inside source dirs.
**/.env*
**/*.pem
**/*.key
**/*.dump
**/*.log
**/node_modules
**/output
